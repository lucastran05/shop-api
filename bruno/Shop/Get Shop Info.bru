meta {
  name: Get Shop Info
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/shop
  body: none
  auth: none
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.shop).to.have.property("name");
  });
}
