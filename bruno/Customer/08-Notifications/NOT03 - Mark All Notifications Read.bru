meta {
  name: NOT03 - Mark All Notifications Read
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/notifications/read-all
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().unread_count).to.equal(0);
  });
}
