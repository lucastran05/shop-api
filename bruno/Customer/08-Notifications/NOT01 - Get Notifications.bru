meta {
  name: NOT01 - Get Notifications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/notifications?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  limit: 20
}

script:post-response {
  if (res.getStatus() === 200 && Array.isArray(res.getBody()?.data) && res.getBody().data.length > 0) {
    bru.setEnvVar("notificationId", res.getBody().data[0].id);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
  });
}
