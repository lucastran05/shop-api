meta {
  name: CART02 - Add Item To Cart
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/cart/items
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "product_id": "{{productId}}",
    "quantity": 2
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.items).to.be.an("array");
  });
}
