meta {
  name: CART01 - Get Cart
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("line_count");
    expect(res.getBody().data).to.have.property("items");
  });
}
