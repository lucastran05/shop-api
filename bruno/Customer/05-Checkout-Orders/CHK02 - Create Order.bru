meta {
  name: CHK02 - Create Order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "quote_id": "{{quoteId}}",
    "note": "Giao hàng cẩn thận giúp em"
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.getBody()?.data?.id) {
    bru.setEnvVar("orderId", res.getBody().data.id);
  }
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("code");
    expect(res.getBody().data).to.have.property("id");
  });
}
