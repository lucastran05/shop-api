meta {
  name: ORD03 - Cancel Order
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "Em đổi ý muốn chọn màu khác"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.status).to.equal("cancelled");
  });
}
