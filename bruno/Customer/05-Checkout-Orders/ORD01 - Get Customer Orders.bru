meta {
  name: ORD01 - Get Customer Orders
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/orders?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  limit: 20
  ~status: pending
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody()).to.have.property("pagination");
  });
}
