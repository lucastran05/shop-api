meta {
  name: ADR04 - Delete Address
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/me/addresses/{{addressId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
