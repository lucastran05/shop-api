meta {
  name: AUTH06 - Update Password Me
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/me/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "current_password": "Password@123",
    "new_password": "Password@456",
    "new_password_confirmation": "Password@456"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
