meta {
  name: ADR01 - Get Customer Addresses
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/me/addresses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
  });
}
