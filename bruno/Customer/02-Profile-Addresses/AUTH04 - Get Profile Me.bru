meta {
  name: AUTH04 - Get Profile Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("email");
  });
}
