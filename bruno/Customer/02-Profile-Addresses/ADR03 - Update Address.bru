meta {
  name: ADR03 - Update Address
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/me/addresses/{{addressId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "recipient_name": "Nguyễn Văn Khách (Updated)",
    "street_address": "Số 20 Phố Hàng Bài"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.street_address).to.equal("Số 20 Phố Hàng Bài");
  });
}
