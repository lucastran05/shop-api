meta {
  name: CHAT02 - Get Customer Messages
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/conversations/{{conversationId}}/messages?limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  limit: 50
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody()).to.have.property("pagination");
  });
}
