meta {
  name: AUTH01 - Register Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nguyễn Văn Khách",
    "email": "customer@abcshop.vn",
    "password": "Password@123",
    "password_confirmation": "Password@123"
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.getBody()?.data) {
    const data = res.getBody().data;
    if (data.accessToken) {
      bru.setEnvVar("token", data.accessToken);
      bru.setEnvVar("accessToken", data.accessToken);
    }
    if (data.refreshToken) {
      bru.setEnvVar("refreshToken", data.refreshToken);
    }
    if (data.id) {
      bru.setEnvVar("userId", data.id);
    }
  }
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("accessToken");
    expect(res.getBody().data).to.have.property("id");
  });
}
