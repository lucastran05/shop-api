meta {
  name: Delete Conversation
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/v1/chat/conversations/{{owner}}
  body: none
  auth: bearer
}

params:path {
  owner: lucas@example.com
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("deletedCount");
  });
}
