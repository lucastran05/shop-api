meta {
  name: Logout User
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/users/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
