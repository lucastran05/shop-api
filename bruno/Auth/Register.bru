meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Admin",
    "email": "admin@gmail.com",
    "password": "Password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:5173
}

script:post-response {
  if (res.getStatus() === 201 && res.getBody()?.data) {
    const data = res.getBody().data;
    if (data.accessToken) {
      bru.setEnvVar("token", data.accessToken);
      bru.setEnvVar("accessToken", data.accessToken);
    }
    if (data.refreshToken) {
      bru.setEnvVar("refreshToken", data.refreshToken);
    }
  }
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.user).to.have.property("id");
  });
}
