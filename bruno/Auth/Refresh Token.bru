meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/users/refresh-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody()?.data) {
    const data = res.getBody().data;
    if (data.accessToken) {
      bru.setEnvVar("token", data.accessToken);
      bru.setEnvVar("accessToken", data.accessToken);
    }
    if (data.refreshToken) {
      bru.setEnvVar("refreshToken", data.refreshToken);
    }
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("accessToken");
  });
}
