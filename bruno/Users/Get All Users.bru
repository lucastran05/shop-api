meta {
  name: Get All Users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users?page=1&limit=20&search=&role=&active=
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  ~search: lucas
  ~role: customer
  ~active: true
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("users");
  });
}
