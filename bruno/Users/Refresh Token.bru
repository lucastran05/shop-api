meta {
  name: Refresh Token (Lấy accessToken mới)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/refresh-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody()?.data) {
    const data = res.getBody().data;
    if (data.accessToken) {
      bru.setEnvVar("accessToken", data.accessToken);
      bru.setEnvVar("token", data.accessToken);
    }
    if (data.refreshToken) {
      bru.setEnvVar("refreshToken", data.refreshToken);
    }
  }
}
