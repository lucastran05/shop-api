meta {
  name: ADC01 - Get Admin Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
  });
}
