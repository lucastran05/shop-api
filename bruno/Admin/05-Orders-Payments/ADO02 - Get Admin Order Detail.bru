meta {
  name: ADO02 - Get Admin Order Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/orders/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.id).to.equal(bru.getEnvVar("orderId"));
    expect(res.getBody().data).to.have.property("allowed_next_statuses");
  });
}
