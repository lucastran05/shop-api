meta {
  name: ADO01 - Get Admin Orders
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/orders?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  ~status: pending
  ~payment_status: unpaid
  ~view: payments
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody()).to.have.property("pagination");
  });
}
