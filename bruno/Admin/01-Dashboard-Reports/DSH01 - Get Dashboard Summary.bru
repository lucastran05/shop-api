meta {
  name: DSH01 - Get Dashboard Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/dashboard?from=2026-01-01&to=2026-12-31&timezone=Asia/Ho_Chi_Minh
  body: none
  auth: bearer
}

params:query {
  from: 2026-01-01
  to: 2026-12-31
  timezone: Asia/Ho_Chi_Minh
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("order_count");
    expect(res.getBody().data).to.have.property("recent_orders");
    expect(res.getBody().data).to.have.property("status_counts");
  });
}
