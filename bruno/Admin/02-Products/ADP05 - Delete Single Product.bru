meta {
  name: ADP05 - Delete Single Product
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/admin/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
