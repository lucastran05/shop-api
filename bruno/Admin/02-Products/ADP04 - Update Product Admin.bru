meta {
  name: ADP04 - Update Product Admin
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/admin/products/{{productId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bàn phím cơ ABC Mechanical Pro (Phiên bản 2026)",
    "is_pinned": true
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.is_pinned).to.equal(true);
  });
}
