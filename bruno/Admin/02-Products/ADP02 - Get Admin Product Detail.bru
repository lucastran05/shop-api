meta {
  name: ADP02 - Get Admin Product Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/admin/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.id).to.equal(bru.getEnvVar("productId"));
  });
}
