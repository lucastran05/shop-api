meta {
  name: USR03 - Update User Admin
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/users/{{userId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Nhân Viên CSKH 01 (Trưởng Nhóm)",
    "phone": "0987654321",
    "is_active": true
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.name).to.equal("Nhân Viên CSKH 01 (Trưởng Nhóm)");
  });
}
