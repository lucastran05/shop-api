meta {
  name: USR05 - Bulk Delete Users
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/users/bulk-delete
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "ids": [
      "{{userId}}"
    ]
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("deleted_ids");
    expect(res.getBody().data).to.have.property("failed");
  });
}
