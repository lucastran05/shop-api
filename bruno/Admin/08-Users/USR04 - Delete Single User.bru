meta {
  name: USR04 - Delete Single User
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/admin/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
