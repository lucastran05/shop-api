meta {
  name: Update Payment Status
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/payments/{{paymentId}}/status
  body: json
  auth: bearer
}

params:path {
  paymentId: 98f5a2b1-1234-4567-89ab-cdef01234567
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "completed"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.payment.status).to.equal("completed");
  });
}
