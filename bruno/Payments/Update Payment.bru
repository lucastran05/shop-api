meta {
  name: Update Payment
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/payments/{{paymentId}}
  body: json
  auth: bearer
}

params:path {
  paymentId: 98f5a2b1-1234-4567-89ab-cdef01234567
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "amount": 2500000,
    "payment_method": "bank",
    "status": "completed",
    "transaction_id": "TXN_VN_20261010_001_CONFIRMED",
    "note": "Kế toán đã đối soát ngân hàng thành công"
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.payment).to.have.property("status");
  });
}
