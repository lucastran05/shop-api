meta {
  name: Get Product By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}
  body: none
  auth: none
}

params:path {
  productId: b3e34bcf-697b-402a-a9a3-55913e7ce001
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.product).to.have.property("id");
  });
}
