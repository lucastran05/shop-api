meta {
  name: Delete Product
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/products/{{productId}}
  body: none
  auth: bearer
}

params:path {
  productId: b3e34bcf-697b-402a-a9a3-55913e7ce001
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().message).to.equal("Xóa sản phẩm thành công");
  });
}
