meta {
  name: Get All Notifications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/notifications?page=1&limit=20&type=&unread_only=false&user_id=&owner=
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  unread_only: false
  ~type: order
  ~user_id: 436218af-6b95-478a-b898-d7ba5d2ff119
  ~owner: lucas@example.com
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.notifications).to.be.an("array");
  });
}
