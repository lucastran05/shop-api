# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=shop_db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/shop_db

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_123456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_987654
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (CORS Configuration)
CLIENT_URL=http://localhost:5173
