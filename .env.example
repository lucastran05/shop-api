# ==============================================================================
# SHOP API - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này sang .env:
#    - Linux/macOS: cp .env.example .env
#    - Windows (PowerShell): copy .env.example .env
# 2. Giá trị mặc định dưới đây đã được cấu hình sẵn để chạy ngay với Docker Compose
# ==============================================================================

# Cấu hình máy chủ ứng dụng
PORT=5000
NODE_ENV=development

# Cấu hình Cơ sở dữ liệu PostgreSQL
# - Chạy qua Docker Compose: Host nội bộ tự động trỏ tới service 'postgres'
# - Chạy trực tiếp qua máy host (npm run dev): Đặt DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shop_db

# (Tùy chọn) Chuỗi kết nối trực tiếp PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_db

# Tối ưu Connection Pool cho PostgreSQL
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Cấu hình JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_123456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_987654
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình CORS (Frontend URL kết nối)
CLIENT_URL=http://localhost:5173

# Public URL and local upload storage
PUBLIC_API_URL=http://localhost:5000
UPLOAD_DIR=uploads
JSON_BODY_LIMIT=1mb

# Upload driver: local or minio. Root compose.yaml configures MinIO automatically.
UPLOAD_STORAGE=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=shop-uploads
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Trusted gateway adapters: per-provider HMAC secrets (minimum 32 characters).
# Keep empty to disable webhook processing until an adapter is configured.
PAYMENT_WEBHOOK_SECRETS={}
PAYMENT_WEBHOOK_DEFAULT_PROVIDER=vietqr

# Flower identification (server only)
PLANTNET_API_KEY=
# User-Agent for Wikipedia lookups; Wikimedia asks for contact info, e.g. "ABCShop/1.0 (you@example.com)"
WIKIPEDIA_USER_AGENT=
